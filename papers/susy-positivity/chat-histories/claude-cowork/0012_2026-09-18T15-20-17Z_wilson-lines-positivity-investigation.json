      "01a0b580-20d6-731f-aeee-cf0870df3095-55": {
        "id": "01a0b580-20d6-731f-aeee-cf0870df3095-55",
        "message": {
          "id": "01a0b580-20d6-731f-aeee-cf0870df3095-55",
          "author": {
            "role": "assistant",
            "name": null,
            "metadata": {}
