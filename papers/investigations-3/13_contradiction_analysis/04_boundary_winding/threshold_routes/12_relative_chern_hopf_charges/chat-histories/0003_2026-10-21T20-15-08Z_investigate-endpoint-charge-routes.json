      "msg_090599c9ccbc900e016ad922e8990c819585d5b576c91598e1": {
        "id": "msg_090599c9ccbc900e016ad922e8990c819585d5b576c91598e1",
        "message": {
          "id": "msg_090599c9ccbc900e016ad922e8990c819585d5b576c91598e1",
          "author": {
            "role": "assistant",
            "name": null,
            "metadata": {}
