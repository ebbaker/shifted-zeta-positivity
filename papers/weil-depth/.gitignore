# Ball-matrix archives are deterministic output of numerics/certify_arb.py and are not versioned.
# They are kept outside git (expected layout and hashes: ARCHIVES.md, which is tracked) and are
# regenerated in about a minute per horizon at N=128. Certificates record their content hash.
numerics-archives/
# macOS Finder metadata is not part of the package.
.DS_Store
numerics/output/**/*.json.gz
numerics/output/**/*.log
numerics/logs*
numerics/**/__pycache__/
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.pdf
manuscript/*.tmp
manuscript/*.synctex.gz
