      "msg_0f7b4c27f914de3e016add296221fc8194aa1737b8e58944ac": {
        "id": "msg_0f7b4c27f914de3e016add296221fc8194aa1737b8e58944ac",
        "message": {
          "id": "msg_0f7b4c27f914de3e016add296221fc8194aa1737b8e58944ac",
          "author": {
            "role": "assistant",
            "name": null,
            "metadata": {}
