      "clause": "general_even_convex_transport",
      "status": "proved_in_note",
      "location": "Note21 (3)-(6),(16)-(21)",
      "result": "For every even convex C2 g on[-1,1], g(0)=0, Q(beta)<=Q(alpha)+D_chi||g||inf(beta-alpha)log^3T, with D_chi=A^2(36||chi_second||+1200||chi_prime||), independent of g derivatives."
    },
    {
      "clause": "complete_exterior_field_and_sign",
      "status": "proved_in_note",
      "location": "Note21 (9)-(15),(19)-(20)",
      "result": "Broad separation >=T/4>=2, full opposite-paired real field, |E_T|<=100A log^2T, explicit absolute-difference tail. Imaginary field is absolutely summable; conjugate grouping and convexity make its Newman-time contribution nonpositive."
    },
    {
      "clause": "collision_assembly",
      "status": "proved_by_fixed_test_adaptation",
      "location": "Note21 section 4",
      "result": "Consumes exact Note19/return23 compact-box root-multiset continuity, space/time isolation and finite-event assembly. Does not insert R=T into microscopic Lipschitz theorem. Auxiliary derivative-dependent fixed-test regularity does not enter one-sided transport constant."
    },
    {
      "clause": "cosh_and_full_family_density",
      "status": "proved_in_note",
      "location": "Note21 (22)-(25),(7)",
      "result": "Direct initial layer cake gives C0 TlogT*b^2/(a^2-b^2), fixed b<a=c/2. Flux absorbs via sup L^2exp(-(1-b)L)=4/[e^2(1-b)^2]. Large/small bvlogT cases give N_lambda(T,v)<=B_b TlogT exp(-b v logT). Any fixed b<1/2 allowed by choosing c in(2b,1)."
    },
    {
      "clause": "second_transverse_moment",
      "status": "proved_in_note",
      "location": "Note21 (8),(26)",
      "result": "Complete dyadic sum y_j^2 <= (2B_b/b^2)T/logT, uniformly in time."
    },
    {
      "clause": "all_order_local_moment",
      "status": "proved_in_note",
      "location": "Note21 (27)-(30)",
      "result": "Three dyadic bands for T>=16 and a fixed-height count for 8<=T<16 yield enlarged tail. Weighted Holder, exact center width and layer cake give C_b_mom R(A_b_mom)^p(2p)!/log^pT for every integer p>=1, uniformly also in lambda."
    }
