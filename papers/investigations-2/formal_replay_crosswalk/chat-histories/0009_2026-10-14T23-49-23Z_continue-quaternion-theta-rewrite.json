      "msg_0da5ae2329a7a7b7016ad01849465481968df51822d6efd1b8": {
        "id": "msg_0da5ae2329a7a7b7016ad01849465481968df51822d6efd1b8",
        "message": {
          "id": "msg_0da5ae2329a7a7b7016ad01849465481968df51822d6efd1b8",
          "author": {
            "role": "assistant",
            "name": null,
            "metadata": {}
