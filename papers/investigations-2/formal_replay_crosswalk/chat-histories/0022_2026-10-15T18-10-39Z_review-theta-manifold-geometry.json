      "msg_08ba6fc305d299f8016ad11bc621888190b4cf24ca9f051605": {
        "id": "msg_08ba6fc305d299f8016ad11bc621888190b4cf24ca9f051605",
        "message": {
          "id": "msg_08ba6fc305d299f8016ad11bc621888190b4cf24ca9f051605",
          "author": {
            "role": "assistant",
