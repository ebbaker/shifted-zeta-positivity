# LaTeX build artefacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
build.log

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Generated working-draft PDFs belong in root output/pdf/, not research folders.
# Existing tracked release PDFs remain tracked (see LARGE_FILES.md, rule 8).
*.pdf

# Third-party PDFs are never committed (see references/README.md)
references/*.pdf

# Large derived data are never committed; they live in the external szp-archive folder
# described by each paper's ARCHIVES.md (conventions and procedure: LARGE_FILES.md)
numerics-archives/

# Runtime locks and recoverable stages for automatic public chat captures
.chat-history-refresh.lock
.chat-history-transaction/

# Locally built reading copies of draft manuscripts (root output/pdf/); rebuild them
# from each manuscript's .tex source. Anchored so that numerics/output/ folders stay tracked.
/output/
